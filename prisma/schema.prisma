// Schema da base de dados do AeroTiming (Supabase Postgres).
// Notas da revisão e decisões: GUIA_MIGRACAO.md → Fase 3.
//
// Convenções:
// - Tabelas/colunas em snake_case na BD (@@map/@map), camelCase no código.
// - Datas de calendário em @db.Date; instantes em @db.Timestamptz(3) (com fuso).
// - Dinheiro em Kwanzas inteiros (Int). Tempos de prova em milissegundos (Int).
// - O que o Prisma não gere (triggers do Supabase Auth e RLS) está em SQL à parte — ver Fase 4.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ───────────── Enums ─────────────

enum UserRole {
  atleta
  organizador
  admin
}

enum Gender {
  M
  F
}

enum DocumentType {
  BI
  PASSAPORTE
}

enum TShirtSize {
  XS
  S
  M
  L
  XL
  XXL
}

/// Estado editorial do evento. "Últimas vagas" e "Esgotado" NÃO são guardados:
/// calculam-se a partir das vagas (slotsTaken / totalSlots) no mapper.
enum EventStatus {
  rascunho // só visível no admin
  brevemente // publicado, inscrições ainda não abriram
  inscricoes_abertas
  inscricoes_encerradas
  a_decorrer
  terminado
  cancelado
}

enum EventStaffRole {
  organizador // gere o evento (dados, inscrições, resultados)
  staff // voluntário: check-in / levantamento de kits
}

enum RoutePointType {
  partida
  chegada
  agua
  abastecimento
  medico
  controlo
}

enum RegistrationStatus {
  pagamento_pendente
  confirmada
  cancelada
  expirada
}

enum KitStatus {
  por_levantar
  levantado
}

enum PaymentMethod {
  multicaixa_express // transferência para o número Multicaixa Express
  transferencia // transferência bancária para o IBAN
  deposito // depósito ao balcão
  kwik // pagamento instantâneo KWiK
}

enum PaymentStatus {
  pendente // aguarda o pagamento/comprovativo
  em_analise // comprovativo enviado, aguarda confirmação do admin
  confirmado
  rejeitado // comprovativo inválido — o atleta pode reenviar
  expirado
  cancelado
  reembolsado
}

enum ResultStatus {
  terminou
  desistiu
  desclassificado
  nao_partiu
}

enum SponsorTier {
  principal
  oficial
  apoio
}

enum BannerKind {
  evento
  publicidade
  memoria
}

// ───────────── Utilizadores ─────────────

/// Perfil da aplicação. O `id` é o mesmo de `auth.users.id` (Supabase Auth). É criado e
/// apagado por triggers em auth.users (SQL à parte, ver Fase 4) — sem FK entre schemas.
/// Papéis: todos começam como `atleta`; o admin promove a `organizador`; o admin master
/// é criado pelo seed. Login só por e-mail + palavra-passe.
model Profile {
  id                String        @id @db.Uuid
  email             String        @unique
  name              String
  phone             String?       @unique // E.164 (+244923000000) — pedido na 1.ª inscrição, não no registo
  role              UserRole      @default(atleta)
  birthDate         DateTime?     @map("birth_date") @db.Date
  gender            Gender?
  documentType      DocumentType? @map("document_type")
  documentNumber    String?       @map("document_number")
  province          String?
  city              String?
  club              String?
  tshirt            TShirtSize?
  bloodType         String?       @map("blood_type")
  emergencyName     String?       @map("emergency_name")
  emergencyPhone    String?       @map("emergency_phone")
  emergencyRelation String?       @map("emergency_relation")
  notifySms         Boolean       @default(true) @map("notify_sms")
  notifyEmail       Boolean       @default(true) @map("notify_email")
  notifyWhatsapp    Boolean       @default(false) @map("notify_whatsapp")
  active            Boolean       @default(true)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  registrations Registration[]
  staffOf       EventStaff[]
  alerts        EventAlert[]

  @@map("profiles")
}

// ───────────── Catálogo ─────────────

model Category {
  slug        String  @id
  name        String
  description String
  sortOrder   Int     @default(0) @map("sort_order")
  events      Event[]

  @@map("categories")
}

model Sponsor {
  id        String         @id @default(cuid())
  name      String
  logoUrl   String         @map("logo_url")
  url       String?
  tier      SponsorTier    @default(apoio)
  active    Boolean        @default(true)
  sortOrder Int            @default(0) @map("sort_order")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  events    EventSponsor[]

  @@map("sponsors")
}

model Banner {
  id        String     @id @default(cuid())
  title     String
  subtitle  String
  imageUrl  String     @map("image_url")
  ctaLabel  String     @map("cta_label")
  href      String
  kind      BannerKind @default(evento)
  active    Boolean    @default(true)
  sortOrder Int        @default(0) @map("sort_order")
  startsAt  DateTime?  @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime?  @map("ends_at") @db.Timestamptz(3)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([active, sortOrder])
  @@map("banners")
}

// ───────────── Eventos ─────────────

model Event {
  id                 String      @id @default(cuid())
  slug               String      @unique
  title              String
  edition            Int         @default(1)
  categorySlug       String      @map("category_slug")
  category           Category    @relation(fields: [categorySlug], references: [slug], onUpdate: Cascade)
  date               DateTime    @db.Date
  startTime          String      @map("start_time") // "HH:mm", hora de Luanda (WAT)
  province           String
  city               String
  venue              String
  address            String
  mapUrl             String?     @map("map_url")
  posterUrl          String      @map("poster_url")
  coverUrl           String      @map("cover_url")
  status             EventStatus @default(rascunho)
  registrationOpens  DateTime    @map("registration_opens") @db.Date
  registrationCloses DateTime    @map("registration_closes") @db.Date
  summary            String
  description        String[]
  highlights         String[]
  organizerName      String      @map("organizer_name") // contacto público mostrado no site
  organizerPhone     String      @map("organizer_phone")
  organizerEmail     String      @map("organizer_email")
  kitLocation        String      @map("kit_location")
  kitAddress         String      @map("kit_address")
  kitItems           String[]    @map("kit_items")
  kitNotes           String[]    @map("kit_notes")
  regulationPdfUrl   String?     @map("regulation_pdf_url")
  /// Contas de recebimento do evento (IBAN, Multicaixa Express, KWiK, depósito) — D9.
  /// null = usar as contas da AeroTiming (site_settings → payment_accounts).
  paymentAccounts    Json?       @map("payment_accounts")
  featured           Boolean     @default(false)
  resultsPublished   Boolean     @default(false) @map("results_published")
  publishedAt        DateTime?   @map("published_at") @db.Timestamptz(3)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  distances     EventDistance[]
  kitPickups    KitPickup[]
  schedule      ScheduleItem[]
  regulation    RegulationSection[]
  sponsors      EventSponsor[]
  staff         EventStaff[]
  registrations Registration[]
  results       Result[]
  alerts        EventAlert[]

  @@index([status, date])
  @@index([categorySlug, date])
  @@index([province, date])
  @@index([createdAt])
  @@map("events")
}

/// Quem gere um evento além dos admins (D5): organizadores (tudo no seu evento, incluindo
/// confirmar pagamentos — D10) e staff (só check-in de kits). Quem cria o evento entra aqui.
model EventStaff {
  eventId   String         @map("event_id")
  profileId String         @map("profile_id") @db.Uuid
  role      EventStaffRole @default(organizador)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  event     Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  profile   Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([eventId, profileId])
  @@index([profileId])
  @@map("event_staff")
}

model EventDistance {
  id            String  @id @default(cuid())
  eventId       String  @map("event_id")
  event         Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  code          String // ex.: "42k" — usado no URL ?distancia=
  name          String
  distanceKm    Decimal @map("distance_km") @db.Decimal(7, 3)
  startTime     String  @map("start_time")
  totalSlots    Int     @map("total_slots")
  slotsTaken    Int     @default(0) @map("slots_taken")
  minAge        Int     @default(0) @map("min_age")
  elevationGain Int     @default(0) @map("elevation_gain")
  timeLimit     String? @map("time_limit")
  bibStart      Int     @default(1) @map("bib_start") // 1.º dorsal desta distância (ex.: 1001)
  nextBib       Int     @default(1) @map("next_bib") // próximo dorsal a atribuir
  sortOrder     Int     @default(0) @map("sort_order")

  tiers         PriceTier[]
  route         EventRoute?
  registrations Registration[]
  results       Result[]

  @@unique([eventId, code])
  @@map("event_distances")
}

model PriceTier {
  id         String        @id @default(cuid())
  distanceId String        @map("distance_id")
  distance   EventDistance @relation(fields: [distanceId], references: [id], onDelete: Cascade)
  label      String
  until      DateTime      @db.Date
  price      Int // Kwanzas
  sortOrder  Int           @default(0) @map("sort_order")

  @@index([distanceId, until])
  @@map("price_tiers")
}

model EventRoute {
  id          String        @id @default(cuid())
  distanceId  String        @unique @map("distance_id")
  distance    EventDistance @relation(fields: [distanceId], references: [id], onDelete: Cascade)
  description String
  surface     String
  path        Json // [[x,y], ...] 0–100 (mapa estilizado)
  elevation   Json // [metros, ...]
  gpxUrl      String?       @map("gpx_url")
  points      RoutePoint[]

  @@map("event_routes")
}

model RoutePoint {
  id      String         @id @default(cuid())
  routeId String         @map("route_id")
  route   EventRoute     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  km      Decimal        @db.Decimal(7, 3)
  name    String
  type    RoutePointType

  @@index([routeId])
  @@map("route_points")
}

model KitPickup {
  id      String   @id @default(cuid())
  eventId String   @map("event_id")
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  date    DateTime @db.Date
  from    String // "HH:mm"
  to      String

  @@index([eventId])
  @@map("kit_pickups")
}

model ScheduleItem {
  id        String @id @default(cuid())
  eventId   String @map("event_id")
  event     Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  time      String
  activity  String
  sortOrder Int    @default(0) @map("sort_order")

  @@index([eventId])
  @@map("schedule_items")
}

model RegulationSection {
  id        String   @id @default(cuid())
  eventId   String   @map("event_id")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title     String
  items     String[]
  sortOrder Int      @default(0) @map("sort_order")

  @@index([eventId])
  @@map("regulation_sections")
}

model EventSponsor {
  eventId   String  @map("event_id")
  sponsorId String  @map("sponsor_id")
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sponsor   Sponsor @relation(fields: [sponsorId], references: [id], onDelete: Cascade)

  @@id([eventId, sponsorId])
  @@index([sponsorId])
  @@map("event_sponsors")
}

/// "Avisem-me quando abrir" — alertas de abertura de inscrições
model EventAlert {
  id        String    @id @default(cuid())
  eventId   String    @map("event_id")
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String?   @map("user_id") @db.Uuid
  user      Profile?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String?
  email     String?
  sentAt    DateTime? @map("sent_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([eventId, sentAt])
  @@map("event_alerts")
}

// ───────────── Inscrições e pagamentos ─────────────

/// Inscrição numa distância. Exige conta (D6): `userId` é sempre preenchido pela aplicação.
/// Na BD é opcional só para manter o histórico quando alguém apaga a conta (SetNull).
/// Guarda uma cópia dos dados do atleta no momento da inscrição.
/// Só uma inscrição ACTIVA por documento e evento (índice único parcial): quem cancelou
/// ou deixou expirar pode inscrever-se de novo.
model Registration {
  id             String             @id @default(cuid())
  code           String             @unique // ex.: AT-2026-00001 (ver Counter)
  eventId        String             @map("event_id")
  event          Event              @relation(fields: [eventId], references: [id]) // Restrict: não apagar eventos com inscrições
  distanceId     String             @map("distance_id")
  distance       EventDistance      @relation(fields: [distanceId], references: [id])
  userId         String?            @map("user_id") @db.Uuid
  user           Profile?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  bib            String? // dorsal — atribuído quando o pagamento é confirmado
  status         RegistrationStatus @default(pagamento_pendente)
  price          Int // valor no momento da inscrição (Kz)
  priceTierLabel String             @map("price_tier_label")

  // Cópia dos dados do atleta no momento da inscrição
  athleteName       String       @map("athlete_name")
  gender            Gender
  birthDate         DateTime     @map("birth_date") @db.Date
  ageGroup          String       @map("age_group")
  documentType      DocumentType @map("document_type")
  documentNumber    String       @map("document_number")
  phone             String // E.164
  email             String?
  province          String
  club              String       @default("Individual")
  nationality       String       @default("Angola")
  tshirt            TShirtSize
  emergencyName     String       @map("emergency_name")
  emergencyPhone    String       @map("emergency_phone")
  emergencyRelation String?      @map("emergency_relation")
  bloodType         String?      @map("blood_type")
  medicalNotes      String?      @map("medical_notes")

  // Consentimentos (Lei n.º 22/11)
  acceptedRulesAt     DateTime @map("accepted_rules_at") @db.Timestamptz(3)
  healthDeclarationAt DateTime @map("health_declaration_at") @db.Timestamptz(3)

  kitStatus       KitStatus @default(por_levantar) @map("kit_status")
  kitPickedUpAt   DateTime? @map("kit_picked_up_at") @db.Timestamptz(3)
  kitPickedUpById String?   @map("kit_picked_up_by_id") @db.Uuid // staff que entregou o kit
  createdById     String?   @map("created_by_id") @db.Uuid // admin, quando criada no painel
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  payments Payment[]
  result   Result?

  @@unique([eventId, bib])
  @@unique([eventId, documentNumber], map: "registrations_active_document_key", where: raw("status IN ('pagamento_pendente', 'confirmada')"))
  @@index([eventId, status])
  @@index([distanceId, status])
  @@index([userId])
  @@index([phone])
  @@map("registrations")
}

/// Pagamento com confirmação MANUAL (D1): o atleta paga fora do site e envia o comprovativo;
/// o admin ou o organizador do evento confirma (D10). Contas de destino: Event.paymentAccounts
/// ou, se vazio, as da AeroTiming em SiteSetting (D9).
model Payment {
  id              String        @id @default(cuid())
  registrationId  String        @map("registration_id")
  registration    Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  method          PaymentMethod
  status          PaymentStatus @default(pendente)
  amount          Int // Kz
  reference       String // descritivo a indicar no pagamento (= código da inscrição)
  payerName       String?       @map("payer_name") // quem pagou (pode não ser o atleta)
  payerPhone      String?       @map("payer_phone")
  transactionRef  String?       @map("transaction_ref") // nº da operação no comprovativo
  proofUrl        String?       @map("proof_url") // caminho no bucket privado "comprovativos"
  proofHash       String?       @map("proof_hash") // SHA-256 do ficheiro (detectar repetidos)
  proofUploadedAt DateTime?     @map("proof_uploaded_at") @db.Timestamptz(3)
  notes           String? // observação do atleta
  reviewNote      String?       @map("review_note") // nota do admin / motivo da rejeição
  expiresAt       DateTime?     @map("expires_at") @db.Timestamptz(3) // prazo para enviar o comprovativo
  confirmedAt     DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  confirmedById   String?       @map("confirmed_by_id") @db.Uuid // admin ou organizador
  // Reservado para o pagamento automático (futuro)
  provider        String?
  providerRef     String?       @unique @map("provider_ref")
  rawPayload      Json?         @map("raw_payload")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([registrationId])
  @@index([status, createdAt])
  @@index([status, expiresAt])
  @@index([transactionRef])
  @@index([proofHash])
  @@map("payments")
}

// ───────────── Resultados ─────────────

model Result {
  id               String        @id @default(cuid())
  eventId          String        @map("event_id")
  event            Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  distanceId       String        @map("distance_id")
  distance         EventDistance @relation(fields: [distanceId], references: [id], onDelete: Cascade)
  registrationId   String?       @unique @map("registration_id")
  registration     Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  bib              String
  name             String
  gender           Gender
  ageGroup         String        @map("age_group")
  club             String
  nationality      String        @default("Angola")
  position         Int?
  positionGender   Int?          @map("position_gender")
  positionAgeGroup Int?          @map("position_age_group")
  chipTimeMs       Int?          @map("chip_time_ms")
  gunTimeMs        Int?          @map("gun_time_ms")
  status           ResultStatus  @default(terminou)
  splits           Json          @default("[]") // [{ label: "5 km", timeMs: 1234567 }]
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([eventId, bib])
  @@index([eventId, distanceId, position])
  @@index([distanceId, gender, positionGender])
  @@map("results")
}

// ───────────── Outros ─────────────

/// Limite de tentativas (7.9): contador por chave (ex.: "login:email:ana@x.ao") numa janela de tempo fixa.
model RateLimit {
  key         String   @id
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  hits        Int      @default(0)

  @@index([windowStart])
  @@map("rate_limits")
}

/// Contadores atómicos: código das inscrições por ano (chave "registration:2026").
model Counter {
  key   String @id
  value Int    @default(0)

  @@map("counters")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([handled, createdAt])
  @@map("contact_messages")
}

/// Definições do site (contactos, redes sociais, contas de recebimento `payment_accounts`…)
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("site_settings")
}

/// Registo de acções do admin/staff (confirmar pagamento, entregar kit, publicar resultados…)
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?  @map("actor_id") @db.Uuid
  action    String // ex.: "payment.confirm"
  entity    String
  entityId  String   @map("entity_id")
  data      Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
