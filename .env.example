# URL pública do site (usada em metadados / links partilhados)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Base de dados (Supabase → botão "Connect" → separador ORMs → Prisma) ──
# Transaction pooler, porta 6543 — usada pela aplicação
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.<REF>:<PASSWORD>@aws-0-<REGIAO>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler, porta 5432 — usada pelas migrações (prisma migrate)
# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.<REF>:<PASSWORD>@aws-0-<REGIAO>.pooler.supabase.com:5432/postgres"

# ── Supabase (Project Settings → API Keys) ──
# O endereço do seu projecto: diz ao site a que Supabase falar
NEXT_PUBLIC_SUPABASE_URL="https://<REF>.supabase.co"
# Chave publicável: sb_publishable_... (ou a antiga "anon")
# Chave "pública" para o login e o registo funcionarem no browser. Pode ser vista por qualquer pessoa, por isso só permite o que é seguro
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Chave secreta: sb_secret_... (ou a antiga "service_role") — SÓ servidor, nunca com NEXT_PUBLIC_
# Chave com poder total: apagar utilizadores, enviar ficheiros privados, etc. Só o servidor a usa, por exemplo no admin
SUPABASE_SECRET_KEY=""

# ── Admin master ──
# Desenvolvimento: "npm run db:seed" cria o admin, as contas de teste e os dados de demonstração.
# Produção: "npm run db:seed:producao" cria só o admin, as modalidades e o nome do site (sem demonstração).
# Use uma palavra-passe forte (em produção, pelo menos 12 caracteres). Pode mudá-la depois de entrar.
ADMIN_NAME="Administrador Conexão Sport"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
SEED_TEST_PASSWORD=""   # palavra-passe das contas de teste (atleta e organizador) — só dev

# ── Tarefas agendadas (ex.: expirar inscrições sem comprovativo) ──
# Segredo enviado no cabeçalho Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""
